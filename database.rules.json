{
  "rules": {
    "rooms": {
      ".indexOn": ["createdAt"],
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('hostId').val() === auth.uid) || data.child('hostId').val() === auth.uid)",
        ".validate": "$code.matches(/^[A-Z0-9]{4}$/) && newData.hasChildren(['code', 'hostId', 'createdAt', 'state', 'settings'])",
        "code": { ".validate": "newData.val() === $code" },
        "hostId": { ".validate": "newData.isString() && (!data.exists() || newData.val() === data.val())" },
        "createdAt": { ".validate": "newData.isNumber() && (!data.exists() || newData.val() === data.val())" },
        "state": { ".validate": "newData.isString() && newData.val().matches(/^(LOBBY|PLAYING|PROMPT_REVEALED|VOTING|REVEALED)$/)" },
        "settings": {
          ".validate": "newData.hasChildren(['imposters', 'type'])",
          "imposters": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 3" },
          "type": { ".validate": "newData.val() === 'question' || newData.val() === 'noun'" },
          "category": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "$other": { ".validate": false }
        },
        "roundData": {
          ".validate": "newData.hasChildren(['common', 'imposter', 'category'])",
          "common": { ".validate": "newData.isString() && newData.val().length <= 300" },
          "imposter": { ".validate": "newData.isString() && newData.val().length <= 300" },
          "category": { ".validate": "newData.isString() && newData.val().length <= 100" },
          "$other": { ".validate": false }
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($code).exists()",
            ".validate": "newData.hasChildren(['id', 'name'])",
            "id": { ".validate": "newData.val() === $uid" },
            "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20" },
            "vote": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "role": { ".validate": "(newData.val() === 'COMMON' || newData.val() === 'IMPOSTER') && (root.child('rooms').child($code).child('hostId').val() === auth.uid || newData.val() === data.val())" },
            "word": { ".validate": "newData.isString() && newData.val().length <= 300 && (root.child('rooms').child($code).child('hostId').val() === auth.uid || newData.val() === data.val())" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
